# ─────────────────────────────────────────────────────────────────────────────
# NEXUS Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# URL of your deployed Backend Web API (e.g. Render / Railway / Azure)
# In local development: http://localhost:5000
# In production: https://nexus-eshop-api.onrender.com (replace with your backend URL)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: Razorpay Key ID for Online Payments
# Leave empty to keep Cash on Delivery (COD) as the primary active checkout method
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# NextAuth / Auth configuration (for production JWT session security)
NEXTAUTH_SECRET=your-production-32-character-secret-key-here
NEXTAUTH_URL=http://localhost:3000
