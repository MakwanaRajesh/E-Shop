{
  "ConnectionStrings": {
    "DefaultConnection": "Host=<neon-host>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require;Channel Binding=require"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_SUPER_SECURE_RANDOM_256BIT_SECRET_KEY_HERE_FOR_PROD",
    "Issuer": "EShopAPI",
    "Audience": "EShopClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "FRONTEND_URL": "https://your-frontend-domain.vercel.app",
  "Cors": {
    "AllowedOrigins": [
      "https://your-frontend-domain.vercel.app",
      "http://localhost:3000"
    ]
  },
  "Razorpay": {
    "KeyId": "",
    "KeySecret": ""
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Resend": {
    "ApiKey": "",
    "FromEmail": "orders@nexus.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
